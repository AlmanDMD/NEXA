APP_NAME="NEXA Backend API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

HOST="127.0.0.1"
PORT=8000

LOG_LEVEL="INFO"
LOG_JSON=true

BCRYPT_ROUNDS=12

DATABASE_URL="sqlite:///./nexa.db"

JWT_ACCESS_SECRET="gere_com_openssl_rand_hex_32_access_secret_nexa_2026"
JWT_REFRESH_SECRET="gere_com_openssl_rand_hex_32_refresh_secret_nexa_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME="refresh_token"
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE="lax"
REFRESH_COOKIE_PATH="/"

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
