# =============================================================================
# VARIÁVEIS DE AMBIENTE — PROJETO NEXA (SENAI)
# Copie este arquivo para .env: cp .env.example .env
# ATENÇÃO: Nunca versione o arquivo .env com senhas reais no Git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BANCO DE DADOS — POSTGRESQL 16 (DOCKER COMPOSE - DB-003)
# -----------------------------------------------------------------------------
POSTGRES_CONTAINER_NAME=nexa-postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nexa_admin
POSTGRES_PASSWORD=troque_esta_senha_local_segura
POSTGRES_DB=nexa_senai_db
POSTGRES_TZ=America/Sao_Paulo

# URL de conexão padrão (SQLAlchemy / Asyncpg / Prisma / Psql)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# 2. AUTENTICAÇÃO & SEGURANÇA (BACK-END - EPIC-01)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=gere_com_openssl_rand_hex_32_access
JWT_REFRESH_SECRET=gere_com_openssl_rand_hex_32_refresh
COOKIE_SECRET=gere_com_openssl_rand_hex_32_cookie
PEDAGOGICAL_NOTES_AES_KEY=gere_chave_aes_256_base64_aqui
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 3. FRONT-END (VITE - EPIC-01)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# 4. AUTOMAÇÃO DO GITHUB PROJECTS / ISSUES
# Crie um token no GitHub: Settings > Developer Settings > Personal access tokens (classic)
# Escopos necessários: repo, project
# -----------------------------------------------------------------------------
GITHUB_TOKEN=coloque_seu_token_ghp_aqui
GITHUB_REPO_OWNER=AlmanDMD
GITHUB_REPO_NAME=NEXA
