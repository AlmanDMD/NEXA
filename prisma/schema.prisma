// =============================================================================
// PROJETO NEXA — SISTEMA INTELIGENTE DE MONITORAMENTO ACADÊMICO SENAI
// CARDS: [DB-004] a [DB-050] Schema Completo NEXA SENAI (33 Tabelas 3FN, 18 Enums, Comunicação, Gamificação & Governança LGPD)
// =============================================================================
// Convenção adotada:
// - Modelos e Enums em PascalCase na camada de aplicação
// - Mapeamento explícito para snake_case no PostgreSQL 16 via @map e @@map
// - Todas as migrations físicas são arquivos SQL puros versionados e executados
//   no container Docker PostgreSQL 16 (postgres:16-alpine).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. ENUMERAÇÕES GLOBAIS PRIMÁRIAS DE SISTEMA (DB-005)
// =============================================================================

/// Papéis de controle de acesso baseado em função (RBAC — EPIC-01 / BE-009)
enum Role {
  ADMIN
  COORDINATOR
  TEACHER
  STUDENT

  @@map("user_role_enum")
}

/// Estados do ciclo de vida da matrícula acadêmica do estudante (EPIC-02)
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED

  @@map("enrollment_status_enum")
}

/// Graus de risco acadêmico precoce e explicável (EPIC-05 / DB-034)
enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@map("risk_level_enum")
}

/// Estados de entrega e avaliação de tarefas práticas de oficina (EPIC-04 / DB-025)
enum SubmissionStatus {
  PENDING
  SUBMITTED
  EVALUATED
  LATE

  @@map("submission_status_enum")
}

/// Estados de atendimento das solicitações confidenciais de apoio (EPIC-08 / DB-042)
enum HelpRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("help_request_status_enum")
}

// =============================================================================
// 2. ENUMERAÇÕES COMPLEMENTARES DE DOMÍNIO ACADÊMICO SENAI (DB-005..DB-050)
// =============================================================================

/// Turnos de funcionamento das turmas SENAI (DB-012)
enum Shift {
  MORNING
  AFTERNOON
  NIGHT

  @@map("shift_enum")
}

/// Estados do período letivo da turma (DB-012 / DB-029)
enum ClassStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED

  @@map("class_status_enum")
}

/// Categorias da taxonomia de competências técnicas SENAI (DB-015)
enum CompetencyCategory {
  TECHNICAL
  SAFETY
  PROCEDURAL

  @@map("competency_category_enum")
}

/// Status de presença na chamada rápida de aula (DB-022)
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  JUSTIFIED

  @@map("attendance_status_enum")
}

/// Tipos de avaliação formativa e somativa (DB-027)
enum AssessmentType {
  EXAM
  MICRO_EVALUATION
  PROJECT

  @@map("assessment_type_enum")
}

/// Categorias de disparo de alertas acadêmicos explicáveis (DB-034)
enum AlertCategory {
  ATTENDANCE
  GRADE_DROP
  PENDING_TASKS
  SELF_EVAL_GAP

  @@map("alert_category_enum")
}

/// Estados de tratamento de alertas acadêmicos pelo professor/coordenação (DB-034)
enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED

  @@map("alert_status_enum")
}

/// Classificação do diagnóstico comparativo Autoavaliação vs. Professor (DB-035)
enum DiagnosticType {
  ALIGNED
  OVERCONFIDENCE_RISK
  UNDERCONFIDENCE_SUPPORT
  INSUFFICIENT_EVIDENCE

  @@map("diagnostic_type_enum")
}

/// Marcos positivos na linha do tempo de autonomia do estudante (DB-039)
enum MilestoneType {
  MODULE_COMPLETED
  SKILL_LEVEL_UP
  PERFECT_ATTENDANCE
  RECOVERY_ACHIEVED

  @@map("milestone_type_enum")
}

/// Prioridade de avisos no mural oficial da turma (DB-041)
enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT

  @@map("announcement_priority_enum")
}

/// Categorias de solicitações confidenciais de apoio pedagógico (DB-042)
enum HelpRequestCategory {
  TECHNICAL_DOUBT
  PRACTICAL_DIFFICULTY
  PERSONAL_PEDAGOGICAL

  @@map("help_request_category_enum")
}

/// Escopos de visibilidade restrita para observações pedagógicas sigilosas (DB-043)
enum NoteVisibilityScope {
  PRIVATE_AUTHOR
  TEACHERS_AND_COORD
  COORDINATION_ONLY

  @@map("note_visibility_scope_enum")
}

/// Categorias de observações pedagógicas restritas (DB-043)
enum NoteCategory {
  INTERVENTION
  MENTORING
  BEHAVIORAL
  ACCOMMODATION

  @@map("note_category_enum")
}

// =============================================================================
// 3. TABELAS DE IDENTIDADE, PERFIS, SESSÕES E AUDITORIA (DB-004..DB-009)
// =============================================================================

/// Tabela de controle de versionamento de migrations SQL aplicadas no PostgreSQL 16 (DB-004)
model SchemaMigration {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  version         String   @unique @map("version") @db.VarChar(100)
  migrationName   String   @map("migration_name") @db.VarChar(255)
  checksumSha256  String   @map("checksum_sha256") @db.VarChar(64)
  executionTimeMs Int      @default(0) @map("execution_time_ms")
  appliedBy       String   @default("docker-sql-runner") @map("applied_by") @db.VarChar(100)
  appliedAt       DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}

/// Entidade central de autenticação do sistema com proteção de credenciais (DB-006)
model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  email        String        @unique(map: "uq_users_email") @map("email") @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         Role          @default(STUDENT) @map("role")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  profile      UserProfile?
  sessions     AuthSession[]
  auditLogs          AuditLog[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  classLessons          ClassLesson[]
  attendanceRecords     AttendanceRecord[]
  taskSubmissions       TaskSubmission[]
  submissionEvaluations SubmissionEvaluation[]
  studentGrades         StudentGrade[]         @relation("StudentGradeStudent")
  recordedGrades         StudentGrade[]          @relation("StudentGradeRecorder")
  selfAssessmentForms    SelfAssessmentForm[]
  studentSelfAssessments StudentSelfAssessment[]
  skillEvidences         SkillEvidence[]           @relation("SkillEvidenceStudent")
  verifiedEvidences      SkillEvidence[]           @relation("SkillEvidenceVerifier")
  academicAlerts         AcademicAlert[]           @relation("AcademicAlertStudent")
  resolvedAlerts         AcademicAlert[]           @relation("AcademicAlertResolver")
  explainableDiagnostics ExplainableDiagnostic[]
  milestoneHistory       StudentMilestoneHistory[]
  authoredAnnouncements  ClassAnnouncement[]
  studentHelpRequests    HelpRequest[]             @relation("HelpRequestStudent")
  assignedHelpRequests   HelpRequest[]             @relation("HelpRequestTeacher")
  studentNotes           PedagogicalNote[]         @relation("PedagogicalNoteStudent")
  authoredNotes          PedagogicalNote[]         @relation("PedagogicalNoteAuthor")
  sentChatMessages       ChatMessage[]
  achievements           StudentAchievement[]

  @@index([email], map: "idx_users_email")
  @@index([role, isActive], map: "idx_users_role_is_active")
  @@map("users")
}

/// Perfil institucional e dados pessoais isolados 1:1 para minimização LGPD (DB-007)
model UserProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId             String   @unique(map: "uq_user_profiles_user_id") @map("user_id") @db.Uuid
  fullName           String   @map("full_name") @db.VarChar(150)
  registrationNumber String   @unique(map: "uq_user_profiles_registration_number") @map("registration_number") @db.VarChar(50)
  phone              String?  @map("phone") @db.VarChar(25)
  avatarUrl          String?  @map("avatar_url") @db.VarChar(500)
  bio                String?  @map("bio") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_user_profiles_user")

  @@index([registrationNumber], map: "idx_user_profiles_registration_number")
  @@index([fullName], map: "idx_user_profiles_full_name")
  @@map("user_profiles")
}

/// Sessões ativas e Refresh Tokens com revogação imediata e hash SHA-256 (DB-008)
model AuthSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique(map: "uq_auth_sessions_token_hash") @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?  @map("user_agent") @db.VarChar(500)
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_auth_sessions_user")

  @@index([refreshTokenHash], map: "idx_auth_sessions_refresh_token_hash")
  @@index([isRevoked], map: "idx_auth_sessions_is_revoked")
  @@index([userId, isRevoked, expiresAt], map: "idx_auth_sessions_user_revoked_expires")
  @@map("auth_sessions")
}

/// Registro imutável de atividades críticas e trilha de auditoria LGPD em JSONB (DB-009)
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @map("action") @db.VarChar(100)
  entity    String   @map("entity") @db.VarChar(100)
  entityId  String   @map("entity_id") @db.VarChar(100)
  oldValues Json?    @map("old_values") @db.JsonB
  newValues Json?    @map("new_values") @db.JsonB
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_audit_logs_user")

  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([entity, entityId], map: "idx_audit_logs_entity_reference")
  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_logs_user_created_at")
  @@map("audit_logs")
}

// =============================================================================
// 4. TABELAS DE GESTÃO ACADÊMICA E ESTRUTURA SENAI (DB-011..DB-020)
// =============================================================================

/// Cursos técnicos profissionalizantes ofertados pela unidade SENAI (DB-011)
model Course {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code        String   @unique(map: "uq_courses_code") @map("code") @db.VarChar(30)
  name        String   @map("name") @db.VarChar(150)
  description String?  @map("description") @db.Text
  totalHours  Int      @map("total_hours")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  classes     Class[]
  subjects    Subject[]

  @@index([code], map: "idx_courses_code")
  @@index([name], map: "idx_courses_name")
  @@index([isActive], map: "idx_courses_is_active")
  @@map("courses")
}

/// Turmas acadêmicas letivas vinculadas a um curso técnico e período letivo (DB-012 / DB-019)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-019):
/// - `chk_classes_date_range`: `CHECK (start_date < end_date)`
/// - `chk_classes_max_students`: `CHECK (max_students > 0 AND max_students <= 100)`
/// - `trg_classes_validate_max_students_reduction`: impede reduzir `max_students` abaixo das matrículas `ACTIVE`
/// - `fn_prevent_closed_class_mutation` (DB-029): bloqueia `INSERT`/`UPDATE`/`DELETE` em `student_grades`, `attendance_records`, `task_submissions` e `submission_evaluations` quando `status IN ('COMPLETED', 'ARCHIVED')` (mantendo `SELECT` liberado)
model Class {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  courseId    String      @map("course_id") @db.Uuid
  code        String      @map("code") @db.VarChar(40)
  period      String      @map("period") @db.VarChar(20)
  shift       Shift       @map("shift")
  maxStudents Int         @default(40) @map("max_students")
  status      ClassStatus @default(PLANNING) @map("status")
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_classes_course")
  enrollments        Enrollment[]
  teacherAssignments  TeacherAssignment[]
  classLessons        ClassLesson[]
  practicalTasks      PracticalTask[]
  academicAssessments    AcademicAssessment[]
  selfAssessmentForms    SelfAssessmentForm[]
  academicAlerts         AcademicAlert[]
  explainableDiagnostics ExplainableDiagnostic[]
  announcements          ClassAnnouncement[]

  @@unique([code, period], map: "uq_classes_code_period")
  @@index([courseId, period], map: "idx_classes_course_period")
  @@index([status, period], map: "idx_classes_status_period")
  @@index([shift], map: "idx_classes_shift")
  @@map("classes")
}

/// Disciplinas teórico-práticas (Unidades Curriculares) da matriz do curso SENAI (DB-013)
model Subject {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  code          String   @map("code") @db.VarChar(50)
  name          String   @map("name") @db.VarChar(150)
  workloadHours Int      @map("workload_hours")
  syllabus      String?  @map("syllabus") @db.Text
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_subjects_course")
  learningModules    LearningModule[]
  teacherAssignments  TeacherAssignment[]
  classLessons        ClassLesson[]
  academicAssessments AcademicAssessment[]
  announcements       ClassAnnouncement[]
  helpRequests        HelpRequest[]

  @@unique([courseId, code], map: "uq_subjects_course_code")
  @@index([name], map: "idx_subjects_name")
  @@index([courseId, isActive], map: "idx_subjects_course_active")
  @@map("subjects")
}

/// Módulos de aprendizagem prática SENAI sequenciais dentro de uma disciplina (DB-014)
model LearningModule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  title          String   @map("title") @db.VarChar(120)
  orderIndex     Int      @map("order_index")
  description    String?  @map("description") @db.Text
  practicalHours Int      @map("practical_hours")
  moduleWeight   Decimal  @default(1.00) @map("module_weight") @db.Decimal(4, 2)
  passingScore   Decimal  @default(6.00) @map("passing_score") @db.Decimal(4, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_learning_modules_subject")
  moduleCompetencies ModuleCompetency[]
  classLessons        ClassLesson[]
  practicalTasks      PracticalTask[]
  academicAssessments    AcademicAssessment[]
  selfAssessmentForms    SelfAssessmentForm[]
  academicAlerts         AcademicAlert[]
  explainableDiagnostics ExplainableDiagnostic[]
  milestoneHistory       StudentMilestoneHistory[]
  helpRequests           HelpRequest[]

  @@unique([subjectId, orderIndex], map: "uq_learning_modules_subject_order")
  @@index([subjectId, orderIndex], map: "idx_learning_modules_subject_order")
  @@index([title], map: "idx_learning_modules_title")
  @@map("learning_modules")
}

/// Taxonomia de competências e habilidades técnicas industriais SENAI (DB-015)
model Competency {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code               String             @unique(map: "uq_competencies_code") @map("code") @db.VarChar(50)
  title              String             @map("title") @db.VarChar(150)
  category           CompetencyCategory @map("category")
  description        String?            @map("description") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  moduleCompetencies     ModuleCompetency[]
  taskCriteria           TaskCriterion[]
  studentSelfAssessments StudentSelfAssessment[]
  skillEvidences         SkillEvidence[]
  explainableDiagnostics ExplainableDiagnostic[]
  gamificationBadges     GamificationBadge[]

  @@index([code], map: "idx_competencies_code")
  @@index([category], map: "idx_competencies_category")
  @@index([title], map: "idx_competencies_title")
  @@map("competencies")
}

/// Relacionamento associativo N:M entre módulos práticos e competências técnicas SENAI (DB-016)
model ModuleCompetency {
  moduleId      String         @map("module_id") @db.Uuid
  competencyId  String         @map("competency_id") @db.Uuid
  weight        Decimal        @default(1.00) @map("weight") @db.Decimal(3, 2)
  requiredLevel Int            @default(3) @map("required_level")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  module        LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_module_competencies_module")
  competency    Competency     @relation(fields: [competencyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_module_competencies_competency")

  @@id([moduleId, competencyId], map: "pk_module_competencies")
  @@index([competencyId], map: "idx_module_competencies_competency")
  @@index([moduleId, requiredLevel], map: "idx_module_competencies_module_level")
  @@map("module_competencies")
}

/// Matrícula formal de um estudante (role = STUDENT) em uma turma acadêmica (DB-017 / DB-019)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-019):
/// - `uq_enrollments_student_class`: `UNIQUE (student_id, class_id)`
/// - `chk_enrollments_final_grade`: `CHECK (final_grade IS NULL OR (final_grade >= 0.00 AND final_grade <= 10.00))`
/// - `chk_enrollments_attendance_rate`: `CHECK (attendance_rate IS NULL OR (attendance_rate >= 0.00 AND attendance_rate <= 100.00))`
/// - `trg_enrollments_validate_student_role_and_touch`: exige `users.role = 'STUDENT'`
/// - `trg_enrollments_enforce_class_capacity`: lock pessimista (`FOR UPDATE`) garantindo `COUNT(ACTIVE) <= classes.max_students`
model Enrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  enrollmentDate DateTime         @default(dbgenerated("CURRENT_DATE")) @map("enrollment_date") @db.Date
  status         EnrollmentStatus @default(ACTIVE) @map("status")
  finalGrade     Decimal?         @map("final_grade") @db.Decimal(4, 2)
  attendanceRate Decimal?         @map("attendance_rate") @db.Decimal(5, 2)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  student           User               @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_enrollments_student")
  class             Class              @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_enrollments_class")
  attendanceRecords AttendanceRecord[]
  taskSubmissions   TaskSubmission[]
  studentGrades     StudentGrade[]
  academicAlerts    AcademicAlert[]
  milestoneHistory  StudentMilestoneHistory[]
  helpRequests      HelpRequest[]
  pedagogicalNotes  PedagogicalNote[]
  achievements      StudentAchievement[]

  @@unique([studentId, classId], map: "uq_enrollments_student_class")
  @@index([attendanceRate], map: "idx_enrollments_attendance_rate")
  @@index([classId, status], map: "idx_enrollments_class_status")
  @@index([studentId, status], map: "idx_enrollments_student_status")
  @@map("enrollments")
}

/// Associação de professores (role = TEACHER) a turmas e disciplinas para RBAC contextual (DB-018)
model TeacherAssignment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  teacherId     String   @map("teacher_id") @db.Uuid
  classId       String   @map("class_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  assignedAt    DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  isMainTeacher Boolean  @default(true) @map("is_main_teacher")
  teacher       User     @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_teacher_assignments_teacher")
  class         Class    @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_teacher_assignments_class")
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_teacher_assignments_subject")

  @@unique([teacherId, classId, subjectId], map: "uq_teacher_assignments_composite")
  @@index([teacherId, classId], map: "idx_teacher_assignments_teacher_class")
  @@index([classId, subjectId], map: "idx_teacher_assignments_class_subject")
  @@index([subjectId], map: "idx_teacher_assignments_subject")
  @@map("teacher_assignments")
}

// =============================================================================
// 5. TABELAS DE DIÁRIO DE CLASSE: NOTAS & FREQUÊNCIA (DB-021..DB-030)
// =============================================================================

/// Aulas ministradas e diário de bordo por turma, disciplina e módulo prático SENAI (DB-021)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-021):
/// - `chk_class_lessons_workload`: `CHECK (workload_hours BETWEEN 1 AND 8)`
/// - `chk_class_lessons_topic_summary_not_blank`: `CHECK (length(btrim(topic_summary)) > 0)`
/// - `trg_class_lessons_validate_integrity`: bloqueia `teacher_id` com `role = 'STUDENT'`, valida `subjects.course_id = classes.course_id` e garante `learning_modules.subject_id = subject_id` quando `module_id` é informado
model ClassLesson {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  classId        String          @map("class_id") @db.Uuid
  subjectId      String          @map("subject_id") @db.Uuid
  moduleId       String?         @map("module_id") @db.Uuid
  teacherId      String          @map("teacher_id") @db.Uuid
  lessonDate     DateTime        @map("lesson_date") @db.Date
  workloadHours  Int             @default(4) @map("workload_hours")
  topicSummary   String          @map("topic_summary") @db.Text
  labEnvironment String?         @map("lab_environment") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_class_lessons_class")
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_class_lessons_subject")
  module            LearningModule?    @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_class_lessons_module")
  teacher           User               @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_class_lessons_teacher")
  attendanceRecords AttendanceRecord[]

  @@index([classId, subjectId, lessonDate], map: "idx_class_lessons_class_subject_date")
  @@index([moduleId], map: "idx_class_lessons_module")
  @@index([teacherId], map: "idx_class_lessons_teacher")
  @@map("class_lessons")
}

/// Registros atômicos de presença e faltas por estudante em cada aula ministrada (DB-022)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-022):
/// - `uq_attendance_lesson_student`: `UNIQUE (lesson_id, student_id)` (ancora upsert em lote / chamada em 1 clique)
/// - `uq_attendance_lesson_enrollment`: `UNIQUE (lesson_id, enrollment_id)`
/// - `chk_attendance_absent_hours`: `CHECK (absent_hours >= 0 AND absent_hours <= 8)`
/// - `chk_attendance_present_zero_absent`: `CHECK (status <> 'PRESENT' OR absent_hours = 0)`
/// - `trg_attendance_records_validate_integrity`: valida `enrollments.student_id = student_id`, `enrollments.class_id = class_lessons.class_id` e `absent_hours <= class_lessons.workload_hours`
/// - `trg_attendance_records_prevent_closed_class` (DB-029): executa `fn_prevent_closed_class_mutation()` bloqueando mutações quando a turma está `COMPLETED` ou `ARCHIVED`
model AttendanceRecord {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  lessonId          String           @map("lesson_id") @db.Uuid
  enrollmentId      String           @map("enrollment_id") @db.Uuid
  studentId         String           @map("student_id") @db.Uuid
  status            AttendanceStatus @default(PRESENT) @map("status")
  absentHours       Int              @default(0) @map("absent_hours")
  justificationNote String?          @map("justification_note") @db.Text
  recordedAt        DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  lesson            ClassLesson      @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_attendance_lesson")
  enrollment        Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_attendance_enrollment")
  student           User             @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_attendance_student")

  @@unique([lessonId, studentId], map: "uq_attendance_lesson_student")
  @@unique([lessonId, enrollmentId], map: "uq_attendance_lesson_enrollment")
  @@index([studentId, status], map: "idx_attendance_student_status")
  @@index([lessonId], map: "idx_attendance_lesson")
  @@index([enrollmentId, status], map: "idx_attendance_enrollment_status")
  @@map("attendance_records")
}

// =============================================================================
// 6. TABELAS DE ATIVIDADES PRÁTICAS DE OFICINA & COMPETÊNCIAS (DB-023..DB-026)
// =============================================================================

/// Tarefas e peças práticas de bancada/oficina associadas aos módulos técnicos SENAI e turmas (DB-023)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-023):
/// - `chk_practical_tasks_max_score`: `CHECK (max_score >= 1.00 AND max_score <= 10.00)`
/// - `chk_practical_tasks_title_not_blank`: `CHECK (length(btrim(title)) > 0)`
/// - `chk_practical_tasks_blueprint_url`: `CHECK (blueprint_url IS NULL OR blueprint_url ~* '^https?://')`
/// - `trg_practical_tasks_validate_and_touch`: garante que o módulo pertença ao mesmo curso da turma e atualiza `updated_at`
model PracticalTask {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  moduleId     String         @map("module_id") @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  title        String         @map("title") @db.VarChar(150)
  description  String?        @map("description") @db.Text
  blueprintUrl String?        @map("blueprint_url") @db.VarChar(500)
  dueDate      DateTime       @map("due_date") @db.Timestamptz(6)
  maxScore     Decimal        @default(10.00) @map("max_score") @db.Decimal(4, 2)
  isMandatory  Boolean        @default(true) @map("is_mandatory")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  module       LearningModule   @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_practical_tasks_module")
  class        Class            @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_practical_tasks_class")
  criteria     TaskCriterion[]
  submissions  TaskSubmission[]

  @@index([classId, dueDate], map: "idx_practical_tasks_class_due_date")
  @@index([moduleId], map: "idx_practical_tasks_module")
  @@index([classId, isMandatory, dueDate], map: "idx_practical_tasks_class_mandatory_due")
  @@map("practical_tasks")
}

/// Critérios técnicos objetivos e rubricas de avaliação prática vinculadas a competências SENAI (DB-024)
/// Constraints nativas PostgreSQL (@check — DB-024):
/// - `uq_task_criteria_name`: `UNIQUE (task_id, criterion_name)`
/// - `chk_task_criteria_weight`: `CHECK (weight > 0.00 AND weight <= 9.99)` (ponderação automática)
/// - `chk_task_criteria_level`: `CHECK (min_acceptable_level BETWEEN 1 AND 5)`
/// - `chk_task_criteria_name_not_blank`: `CHECK (length(btrim(criterion_name)) > 0)`
model TaskCriterion {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  taskId             String        @map("task_id") @db.Uuid
  competencyId       String        @map("competency_id") @db.Uuid
  criterionName      String        @map("criterion_name") @db.VarChar(180)
  weight             Decimal       @default(1.00) @map("weight") @db.Decimal(3, 2)
  minAcceptableLevel Int           @default(3) @map("min_acceptable_level")
  task               PracticalTask          @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_task_criteria_task")
  competency         Competency             @relation(fields: [competencyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_task_criteria_competency")
  evaluations        SubmissionEvaluation[]

  @@unique([taskId, criterionName], map: "uq_task_criteria_name")
  @@index([taskId], map: "idx_task_criteria_task")
  @@index([competencyId], map: "idx_task_criteria_competency")
  @@map("task_criteria")
}

/// Submissões e controle de estado de entrega/execução das tarefas práticas por estudante (DB-025)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-025):
/// - `uq_task_submissions_task_student`: `UNIQUE (task_id, student_id)`
/// - `uq_task_submissions_task_enrollment`: `UNIQUE (task_id, enrollment_id)`
/// - `chk_task_submissions_score`: `CHECK (final_task_score IS NULL OR (final_task_score >= 0.00 AND final_task_score <= 10.00))`
/// - `chk_task_submissions_evidence_url`: `CHECK (evidence_url IS NULL OR evidence_url ~* '^https?://')`
/// - `trg_task_submissions_validate_and_touch`: exige vínculo `ACTIVE` na turma da tarefa, `final_task_score <= max_score`, impede regressão `EVALUATED -> PENDING` e preenche `completed_at` / `updated_at`
/// - `trg_task_submissions_prevent_closed_class` (DB-029): executa `fn_prevent_closed_class_mutation()` bloqueando mutações quando a turma está `COMPLETED` ou `ARCHIVED`
model TaskSubmission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  taskId         String           @map("task_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  enrollmentId   String           @map("enrollment_id") @db.Uuid
  status         SubmissionStatus @default(PENDING) @map("status")
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  evidenceUrl    String?          @map("evidence_url") @db.VarChar(500)
  studentNotes   String?          @map("student_notes") @db.Text
  finalTaskScore Decimal?         @map("final_task_score") @db.Decimal(4, 2)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  task           PracticalTask          @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_task_submissions_task")
  student        User                   @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_task_submissions_student")
  enrollment     Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_task_submissions_enrollment")
  evaluations    SubmissionEvaluation[]
  skillEvidences SkillEvidence[]

  @@unique([taskId, studentId], map: "uq_task_submissions_task_student")
  @@unique([taskId, enrollmentId], map: "uq_task_submissions_task_enrollment")
  @@index([studentId, status], map: "idx_task_submissions_student_status")
  @@index([taskId, status], map: "idx_task_submissions_task_status")
  @@index([enrollmentId, status], map: "idx_task_submissions_enrollment_status")
  @@map("task_submissions")
}

/// Avaliações por rubrica/critério técnico registradas pelos professores em entregas práticas (DB-026)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-026):
/// - `uq_submission_evaluations_composite`: `UNIQUE (submission_id, criterion_id)`
/// - `chk_submission_evaluations_level`: `CHECK (achieved_level BETWEEN 1 AND 5)`
/// - `chk_submission_evaluations_score`: `CHECK (score_awarded >= 0.00 AND score_awarded <= 10.00)`
/// - `trg_submission_evaluations_validate_integrity`: bloqueia avaliador `STUDENT`, autoavaliação indevida, critério de outra tarefa e `score_awarded > max_score`
/// - `fn_calculate_submission_consolidated_score` + `trg_submission_evaluations_sync_final_score`: consolida a média ponderada em `task_submissions.final_task_score` e promove status para `EVALUATED`
/// - `trg_submission_evaluations_prevent_closed_class` (DB-029): executa `fn_prevent_closed_class_mutation()` bloqueando mutações quando a turma está `COMPLETED` ou `ARCHIVED`
model SubmissionEvaluation {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  submissionId      String         @map("submission_id") @db.Uuid
  criterionId       String         @map("criterion_id") @db.Uuid
  evaluatorId       String         @map("evaluator_id") @db.Uuid
  achievedLevel     Int            @map("achieved_level")
  scoreAwarded      Decimal        @map("score_awarded") @db.Decimal(4, 2)
  technicalFeedback String?        @map("technical_feedback") @db.Text
  evaluatedAt       DateTime       @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  submission        TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_submission_evaluations_submission")
  criterion         TaskCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_submission_evaluations_criterion")
  evaluator         User           @relation(fields: [evaluatorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_submission_evaluations_evaluator")

  @@unique([submissionId, criterionId], map: "uq_submission_evaluations_composite")
  @@index([submissionId], map: "idx_submission_evaluations_submission")
  @@index([criterionId], map: "idx_submission_evaluations_criterion")
  @@index([evaluatorId, evaluatedAt], map: "idx_submission_evaluations_evaluator")
  @@map("submission_evaluations")
}

/// Avaliações teóricas, microavaliações e projetos formativos aplicados por turma, disciplina e módulo opcional (DB-027)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-027):
/// - `chk_assessments_weight_positive`: `CHECK (weight > 0.00 AND weight <= 9.99)`
/// - `chk_assessments_max_grade`: `CHECK (max_grade > 0.00 AND max_grade <= 10.00)`
/// - `chk_assessments_title_not_blank`: `CHECK (length(btrim(title)) >= 3)`
/// - `trg_academic_assessments_validate_integrity`: garante `subject.course_id = class.course_id` e `module.subject_id = subject_id` (quando `module_id` informado)
model AcademicAssessment {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  classId         String          @map("class_id") @db.Uuid
  subjectId       String          @map("subject_id") @db.Uuid
  moduleId        String?         @map("module_id") @db.Uuid
  title           String          @map("title") @db.VarChar(150)
  assessmentType  AssessmentType  @map("assessment_type")
  weight          Decimal         @default(1.00) @map("weight") @db.Decimal(3, 2)
  applicationDate DateTime        @map("application_date") @db.Date
  maxGrade        Decimal         @default(10.00) @map("max_grade") @db.Decimal(4, 2)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  academicClass   Class           @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_assessments_class")
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_assessments_subject")
  module          LearningModule? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_assessments_module")
  grades          StudentGrade[]
  skillEvidences  SkillEvidence[]

  @@index([classId, subjectId, applicationDate], map: "idx_academic_assessments_class_subject_date")
  @@index([applicationDate], map: "idx_academic_assessments_application_date")
  @@index([moduleId], map: "idx_academic_assessments_module")
  @@index([assessmentType], map: "idx_academic_assessments_type")
  @@map("academic_assessments")
}

/// Notas individuais e menções de recuperação obtidas pelos estudantes em avaliações formativas (DB-028)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-028):
/// - `uq_student_grades_assessment_student`: `UNIQUE (assessment_id, student_id)`
/// - `uq_student_grades_assessment_enrollment`: `UNIQUE (assessment_id, enrollment_id)`
/// - `chk_student_grades_value`: `CHECK (grade_value >= 0.00 AND grade_value <= 10.00)`
/// - `chk_student_grades_recovery`: `CHECK (recovery_grade IS NULL OR (recovery_grade >= 0.00 AND recovery_grade <= 10.00))`
/// - `trg_student_grades_validate_and_touch`: exige vínculo de matrícula válido/ativo na turma, perfil docente em `recorded_by` e `grade_value`/`recovery_grade <= max_grade`
/// - `trg_student_grades_audit_update`: registra em `audit_logs` (DB-009) qualquer alteração posterior em nota já publicada
/// - `trg_student_grades_prevent_closed_class` (DB-029): executa `fn_prevent_closed_class_mutation()` bloqueando mutações quando a turma está `COMPLETED` ou `ARCHIVED`
model StudentGrade {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  assessmentId  String             @map("assessment_id") @db.Uuid
  enrollmentId  String             @map("enrollment_id") @db.Uuid
  studentId     String             @map("student_id") @db.Uuid
  recordedBy    String             @map("recorded_by") @db.Uuid
  gradeValue    Decimal            @map("grade_value") @db.Decimal(4, 2)
  recoveryGrade Decimal?           @map("recovery_grade") @db.Decimal(4, 2)
  comments      String?            @map("comments") @db.Text
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  assessment    AcademicAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_grades_assessment")
  enrollment    Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_grades_enrollment")
  student       User               @relation("StudentGradeStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_grades_student")
  recorder      User               @relation("StudentGradeRecorder", fields: [recordedBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_grades_recorded_by")

  @@unique([assessmentId, studentId], map: "uq_student_grades_assessment_student")
  @@unique([assessmentId, enrollmentId], map: "uq_student_grades_assessment_enrollment")
  @@index([assessmentId], map: "idx_student_grades_assessment")
  @@index([studentId], map: "idx_student_grades_student")
  @@index([enrollmentId], map: "idx_student_grades_enrollment")
  @@index([recordedBy, updatedAt], map: "idx_student_grades_recorded_by")
  @@index([assessmentId, gradeValue], map: "idx_student_grades_assessment_score")
  @@index([enrollmentId, assessmentId], map: "idx_student_grades_enrollment_assessment")
  @@map("student_grades")
}

// =============================================================================
// 7. AUTOAVALIAÇÃO, EVIDÊNCIAS, ALERTAS E DIAGNÓSTICO 360° (DB-031..DB-040)
// =============================================================================

/// Ciclos e questionários de autoavaliação de competências práticas por módulo e turma (DB-031)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-031):
/// - `chk_self_assessment_forms_dates`: `CHECK (opens_at < closes_at)`
/// - `chk_self_assessment_forms_title_not_blank`: `CHECK (length(btrim(title)) >= 3)`
/// - `trg_self_assessment_forms_validate_integrity`: garante `module -> subject.course_id = class.course_id` e perfil docente/gestão em `created_by`
model SelfAssessmentForm {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  moduleId     String         @map("module_id") @db.Uuid
  classId      String         @map("class_id") @db.Uuid
  title        String         @map("title") @db.VarChar(150)
  instructions String?        @map("instructions") @db.Text
  opensAt      DateTime       @map("opens_at") @db.Timestamptz(6)
  closesAt     DateTime       @map("closes_at") @db.Timestamptz(6)
  isActive     Boolean        @default(true) @map("is_active")
  createdBy    String         @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  module       LearningModule          @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_self_assessment_forms_module")
  class        Class                   @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_self_assessment_forms_class")
  creator      User                    @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_self_assessment_forms_creator")
  responses    StudentSelfAssessment[]

  @@index([classId, isActive], map: "idx_self_assessment_forms_class_active")
  @@index([classId, isActive, opensAt, closesAt], map: "idx_self_assessment_forms_window")
  @@index([moduleId], map: "idx_self_assessment_forms_module")
  @@index([createdBy], map: "idx_self_assessment_forms_creator")
  @@map("self_assessment_forms")
}

/// Respostas de autoavaliação de domínio (1..5) e confiança (1..5) declaradas pelo estudante (DB-032)
/// Constraints nativas PostgreSQL (@check / RLS / Triggers — DB-032):
/// - `uq_student_self_assessments_composite`: `UNIQUE (form_id, student_id, competency_id)`
/// - `chk_self_assessments_perceived`: `CHECK (perceived_level BETWEEN 1 AND 5)`
/// - `chk_self_assessments_confidence`: `CHECK (confidence_score BETWEEN 1 AND 5)`
/// - `pol_student_self_assessments_student_isolation`: Row-Level Security (RLS) garantindo que um aluno jamais leia/escreva autoavaliação de outro colega
/// - `trg_student_self_assessments_validate_integrity`: exige perfil `STUDENT`, matrícula `ACTIVE` na turma do formulário, formulário aberto e competência do módulo
model StudentSelfAssessment {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  formId          String             @map("form_id") @db.Uuid
  studentId       String             @map("student_id") @db.Uuid
  competencyId    String             @map("competency_id") @db.Uuid
  perceivedLevel  Int                @map("perceived_level")
  confidenceScore Int                @map("confidence_score")
  difficultyNotes String?            @map("difficulty_notes") @db.Text
  submittedAt     DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  form            SelfAssessmentForm @relation(fields: [formId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_self_assessments_form")
  student         User               @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_self_assessments_student")
  competency      Competency         @relation(fields: [competencyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_self_assessments_competency")

  @@unique([formId, studentId, competencyId], map: "uq_student_self_assessments_composite")
  @@index([studentId, competencyId], map: "idx_student_self_assessments_student_competency")
  @@index([formId, studentId], map: "idx_student_self_assessments_form_student")
  @@index([competencyId], map: "idx_student_self_assessments_competency")
  @@map("student_self_assessments")
}

/// Evidências práticas e formativas verificadas por docentes por competência na escala 1.00..5.00 (DB-033)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-033):
/// - `chk_skill_evidences_level`: `CHECK (verified_level >= 1.00 AND verified_level <= 5.00)`
/// - `chk_skill_evidences_source`: `CHECK (source_submission_id IS NOT NULL OR source_assessment_id IS NOT NULL)`
/// - `trg_skill_evidences_validate_integrity`: exige perfil `STUDENT` em `student_id`, `TEACHER` em `verified_by`, bloqueia autoverificação e valida titularidade da origem
model SkillEvidence {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId          String              @map("student_id") @db.Uuid
  competencyId       String              @map("competency_id") @db.Uuid
  sourceSubmissionId String?             @map("source_submission_id") @db.Uuid
  sourceAssessmentId String?             @map("source_assessment_id") @db.Uuid
  verifiedLevel      Decimal             @map("verified_level") @db.Decimal(3, 2)
  verifiedBy         String              @map("verified_by") @db.Uuid
  recordedAt         DateTime            @default(now()) @map("recorded_at") @db.Timestamptz(6)
  student            User                @relation("SkillEvidenceStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_skill_evidences_student")
  competency         Competency          @relation(fields: [competencyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_skill_evidences_competency")
  sourceSubmission   TaskSubmission?     @relation(fields: [sourceSubmissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_skill_evidences_submission")
  sourceAssessment   AcademicAssessment? @relation(fields: [sourceAssessmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_skill_evidences_assessment")
  verifier           User                @relation("SkillEvidenceVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_skill_evidences_verifier")

  @@index([studentId, competencyId], map: "idx_skill_evidences_student_competency")
  @@index([studentId, recordedAt(sort: Desc)], map: "idx_skill_evidences_student_recorded")
  @@index([verifiedBy], map: "idx_skill_evidences_verified_by")
  @@map("skill_evidences")
}

/// Alertas precoces e explicáveis de risco acadêmico com snapshot JSONB de métricas (DB-034)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-034):
/// - `chk_academic_alerts_reason_not_empty`: `CHECK (CHAR_LENGTH(BTRIM(explainable_reason)) >= 10)`
/// - `chk_academic_alerts_metric_snapshot_object`: `CHECK (jsonb_typeof(metric_snapshot) = 'object')`
/// - `trg_academic_alerts_validate_integrity`: valida coerência entre `enrollment_id`, `student_id` e `class_id` e impede `resolved_by` com perfil `STUDENT`
model AcademicAlert {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  enrollmentId      String          @map("enrollment_id") @db.Uuid
  classId           String          @map("class_id") @db.Uuid
  moduleId          String?         @map("module_id") @db.Uuid
  riskLevel         RiskLevel       @map("risk_level")
  alertCategory     AlertCategory   @map("alert_category")
  explainableReason String          @map("explainable_reason") @db.Text
  metricSnapshot    Json            @map("metric_snapshot") @db.JsonB
  status            AlertStatus     @default(ACTIVE) @map("status")
  resolvedBy        String?         @map("resolved_by") @db.Uuid
  resolutionNotes   String?         @map("resolution_notes") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  student           User            @relation("AcademicAlertStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_academic_alerts_student")
  enrollment        Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_academic_alerts_enrollment")
  academicClass     Class           @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_academic_alerts_class")
  module            LearningModule? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_academic_alerts_module")
  resolver          User?           @relation("AcademicAlertResolver", fields: [resolvedBy], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_academic_alerts_resolver")

  @@index([classId, status, riskLevel], map: "idx_academic_alerts_class_status_risk")
  @@index([classId, riskLevel], map: "idx_academic_alerts_class_risk_level")
  @@index([studentId, status, createdAt(sort: Desc)], map: "idx_academic_alerts_student_status")
  @@index([enrollmentId, status], map: "idx_academic_alerts_enrollment_status")
  @@map("academic_alerts")
}

/// Diagnósticos pedagógicos explicáveis comparando autoavaliação discente e evidência docente (DB-035)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-035):
/// - `chk_diagnostics_self_level` / `chk_diagnostics_teacher_level`: `CHECK (... BETWEEN 1.00 AND 5.00)`
/// - `chk_diagnostics_explanation_not_empty` / `chk_diagnostics_limitations_not_empty` / `chk_diagnostics_action_not_empty`
/// - `trg_explainable_diagnostics_compute_and_validate`: calcula automaticamente `discrepancy_gap = ROUND(self_perceived_level - teacher_verified_level, 2)`
model ExplainableDiagnostic {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId            String         @map("student_id") @db.Uuid
  classId              String         @map("class_id") @db.Uuid
  moduleId             String         @map("module_id") @db.Uuid
  competencyId         String?        @map("competency_id") @db.Uuid
  selfPerceivedLevel   Decimal        @map("self_perceived_level") @db.Decimal(3, 2)
  teacherVerifiedLevel Decimal        @map("teacher_verified_level") @db.Decimal(3, 2)
  discrepancyGap       Decimal        @map("discrepancy_gap") @db.Decimal(3, 2)
  diagnosticType       DiagnosticType @map("diagnostic_type")
  explanationText      String         @map("explanation_text") @db.Text
  limitationsNote      String         @map("limitations_note") @db.Text
  recommendedAction    String         @map("recommended_action") @db.Text
  generatedAt          DateTime       @default(now()) @map("generated_at") @db.Timestamptz(6)
  student              User           @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_diagnostics_student")
  academicClass        Class          @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_diagnostics_class")
  module               LearningModule @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_diagnostics_module")
  competency           Competency?    @relation(fields: [competencyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_diagnostics_competency")

  @@index([classId, diagnosticType], map: "idx_explainable_diagnostics_class_type")
  @@index([studentId, moduleId, generatedAt(sort: Desc)], map: "idx_explainable_diagnostics_student_module")
  @@map("explainable_diagnostics")
}

/// Linha do tempo cronológica de marcos positivos e evolução acadêmica do estudante (DB-039)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-039):
/// - `chk_milestone_history_title_not_empty`: `CHECK (CHAR_LENGTH(BTRIM(title)) >= 3)`
/// - `chk_milestone_history_metadata_object`: `CHECK (metadata IS NULL OR jsonb_typeof(metadata) = 'object')`
/// - `trg_student_milestone_history_validate_integrity`: valida perfil `STUDENT` e coerência com `enrollment_id`
model StudentMilestoneHistory {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId     String          @map("student_id") @db.Uuid
  enrollmentId  String          @map("enrollment_id") @db.Uuid
  moduleId      String?         @map("module_id") @db.Uuid
  milestoneType MilestoneType   @map("milestone_type")
  title         String          @map("title") @db.VarChar(150)
  description   String?         @map("description") @db.Text
  metadata      Json?           @map("metadata") @db.JsonB
  achievedAt    DateTime        @default(now()) @map("achieved_at") @db.Timestamptz(6)
  student       User            @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_milestone_history_student")
  enrollment    Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_milestone_history_enrollment")
  module        LearningModule? @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_milestone_history_module")

  @@index([studentId, achievedAt(sort: Desc)], map: "idx_milestone_history_student_achieved")
  @@index([enrollmentId, achievedAt(sort: Desc)], map: "idx_milestone_history_enrollment_achieved")
  @@index([milestoneType], map: "idx_milestone_history_type")
  @@map("student_milestone_history")
}

// =============================================================================
// 8. COMUNICAÇÃO OFICIAL, APOIO CONFIDENCIAL, NOTAS RESTRITAS & GAMIFICAÇÃO (DB-041..DB-046)
// =============================================================================

/// Mural oficial de avisos publicados por docentes e coordenadores para uma turma/disciplina (DB-041)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-041):
/// - `chk_announcements_title_not_empty` / `chk_announcements_content_not_empty` / `chk_announcements_expiration`
/// - `trg_class_announcements_validate_integrity`: exige perfil docente/gestão em `author_id` e coerência de curso com `subject_id`
model ClassAnnouncement {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  classId       String               @map("class_id") @db.Uuid
  subjectId     String?              @map("subject_id") @db.Uuid
  authorId      String               @map("author_id") @db.Uuid
  title         String               @map("title") @db.VarChar(150)
  content       String               @map("content") @db.Text
  priority      AnnouncementPriority @default(NORMAL) @map("priority")
  isPinned      Boolean              @default(false) @map("is_pinned")
  publishedAt   DateTime             @default(now()) @map("published_at") @db.Timestamptz(6)
  expiresAt     DateTime?            @map("expires_at") @db.Timestamptz(6)
  academicClass Class                @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_announcements_class")
  subject       Subject?             @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_announcements_subject")
  author        User                 @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_announcements_author")

  @@index([classId, isPinned(sort: Desc), publishedAt(sort: Desc)], map: "idx_class_announcements_feed")
  @@index([classId, priority, publishedAt(sort: Desc)], map: "idx_class_announcements_priority")
  @@index([authorId], map: "idx_class_announcements_author")
  @@map("class_announcements")
}

/// Solicitações confidenciais de apoio pedagógico e mentoria feitas por estudantes (DB-042)
/// Constraints nativas PostgreSQL (@check / RLS / Triggers — DB-042):
/// - `pol_help_requests_confidential_isolation`: Row-Level Security impedindo leitura por outros estudantes
/// - `trg_help_requests_validate_integrity`: valida papel `STUDENT`, titularidade de matrícula e máquina de estados `OPEN -> IN_PROGRESS -> RESOLVED -> CLOSED`
model HelpRequest {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId         String              @map("student_id") @db.Uuid
  enrollmentId      String              @map("enrollment_id") @db.Uuid
  subjectId         String              @map("subject_id") @db.Uuid
  moduleId          String?             @map("module_id") @db.Uuid
  assignedTeacherId String?             @map("assigned_teacher_id") @db.Uuid
  category          HelpRequestCategory @map("category")
  subjectTitle      String              @map("subject_title") @db.VarChar(150)
  description       String              @map("description") @db.Text
  isConfidential    Boolean             @default(true) @map("is_confidential")
  status            HelpRequestStatus   @default(OPEN) @map("status")
  resolutionSummary String?             @map("resolution_summary") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  closedAt          DateTime?           @map("closed_at") @db.Timestamptz(6)
  student           User                @relation("HelpRequestStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_help_requests_student")
  enrollment        Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_help_requests_enrollment")
  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_help_requests_subject")
  module            LearningModule?     @relation(fields: [moduleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_help_requests_module")
  assignedTeacher   User?               @relation("HelpRequestTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_help_requests_teacher")
  messages          ChatMessage[]

  @@index([assignedTeacherId, status], map: "idx_help_requests_teacher_status")
  @@index([studentId, status], map: "idx_help_requests_student_status")
  @@index([enrollmentId, status], map: "idx_help_requests_enrollment_status")
  @@map("help_requests")
}

/// Observações pedagógicas restritas com visibility_scope, RLS e trilha obrigatória em audit_logs (DB-043)
/// Constraints nativas PostgreSQL (@check / RLS / Triggers — DB-043):
/// - `trg_pedagogical_notes_audit_trail` + `fn_read_pedagogical_note_audited`: registram toda escrita e leitura em `audit_logs`
/// - `pol_pedagogical_notes_scope_isolation`: impede qualquer leitura por `STUDENT` e aplica `visibility_scope`
model PedagogicalNote {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId        String              @map("student_id") @db.Uuid
  enrollmentId     String              @map("enrollment_id") @db.Uuid
  authorId         String              @map("author_id") @db.Uuid
  visibilityScope  NoteVisibilityScope @default(PRIVATE_AUTHOR) @map("visibility_scope")
  category         NoteCategory        @map("category")
  noteContent      String              @map("note_content") @db.Text
  requiresFollowup Boolean             @default(false) @map("requires_followup")
  followupDate     DateTime?           @map("followup_date") @db.Date
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(6)
  student          User                @relation("PedagogicalNoteStudent", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_pedagogical_notes_student")
  enrollment       Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_pedagogical_notes_enrollment")
  author           User                @relation("PedagogicalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_pedagogical_notes_author")

  @@index([studentId, createdAt(sort: Desc)], map: "idx_pedagogical_notes_student_created")
  @@index([enrollmentId, visibilityScope], map: "idx_pedagogical_notes_enrollment_scope")
  @@index([authorId, requiresFollowup, followupDate], map: "idx_pedagogical_notes_author_followup")
  @@map("pedagogical_notes")
}

/// Mensagens privadas dentro de solicitações de apoio (help_requests) com controle de leitura (DB-044)
/// Constraints nativas PostgreSQL (@check / RLS / Triggers — DB-044):
/// - `fk_chat_messages_help_request`: `ON DELETE CASCADE`
/// - `chk_chat_messages_read_consistency` e `pol_chat_messages_participants_only`
model ChatMessage {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  helpRequestId String      @map("help_request_id") @db.Uuid
  senderId      String      @map("sender_id") @db.Uuid
  messageBody   String      @map("message_body") @db.Text
  isRead        Boolean     @default(false) @map("is_read")
  readAt        DateTime?   @map("read_at") @db.Timestamptz(6)
  sentAt        DateTime    @default(now()) @map("sent_at") @db.Timestamptz(6)
  helpRequest   HelpRequest @relation(fields: [helpRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_chat_messages_help_request")
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_chat_messages_sender")

  @@index([helpRequestId, sentAt(sort: Asc)], map: "idx_chat_messages_request_sent")
  @@map("chat_messages")
}

/// Catálogo transparente de conquistas técnicas SENAI e níveis pedagógicos de XP (DB-045)
/// Constraints nativas PostgreSQL (@check — DB-045):
/// - `uq_gamification_badges_code`: `UNIQUE (code)`
/// - `chk_gamification_badges_criteria_not_empty`: exige critério transparente explícito
/// - `chk_gamification_badges_xp_positive`: `CHECK (xp_reward > 0 AND xp_reward <= 5000)`
model GamificationBadge {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  code                String               @unique(map: "uq_gamification_badges_code") @map("code") @db.VarChar(60)
  title               String               @map("title") @db.VarChar(120)
  description         String               @map("description") @db.Text
  criteriaExplanation String               @map("criteria_explanation") @db.Text
  iconName            String               @map("icon_name") @db.VarChar(80)
  xpReward            Int                  @default(50) @map("xp_reward")
  competencyId        String?              @map("competency_id") @db.Uuid
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  competency          Competency?          @relation(fields: [competencyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_gamification_badges_competency")
  achievements        StudentAchievement[]

  @@index([isActive, competencyId], map: "idx_gamification_badges_active_competency")
  @@index([xpReward(sort: Desc)], map: "idx_gamification_badges_xp")
  @@map("gamification_badges")
}

/// Conquistas técnicas desbloqueadas pelos estudantes sem duplicidade (DB-046)
/// Constraints nativas PostgreSQL (@check / Triggers — DB-046):
/// - `uq_student_achievements_composite`: `UNIQUE (student_id, badge_id)`
/// - `trg_student_achievements_validate_integrity`: valida papel `STUDENT`, matrícula e badge ativo
model StudentAchievement {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  enrollmentId    String            @map("enrollment_id") @db.Uuid
  badgeId         String            @map("badge_id") @db.Uuid
  unlockedAt      DateTime          @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  originReference String            @map("origin_reference") @db.VarChar(150)
  student         User              @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_achievements_student")
  enrollment      Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_achievements_enrollment")
  badge           GamificationBadge @relation(fields: [badgeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_student_achievements_badge")

  @@unique([studentId, badgeId], map: "uq_student_achievements_composite")
  @@index([studentId, unlockedAt(sort: Desc)], map: "idx_student_achievements_student_unlocked")
  @@index([enrollmentId], map: "idx_student_achievements_enrollment")
  @@index([badgeId], map: "idx_student_achievements_badge")
  @@map("student_achievements")
}
